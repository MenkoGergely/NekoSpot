<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NekoSpot"
             x:Class="NekoSpot.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="#FFF8F0"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="#F4A261"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="#5B4636"/>
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="#5B4636"/>
            </Style>

            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="#5B4636"/>
                <Setter Property="PlaceholderColor" Value="#A68A74"/>
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="TextColor" Value="#5B4636"/>
            </Style>

            <Style TargetType="Border">
                <Setter Property="Stroke" Value="#F6D5B8"/>
            </Style>

            <Style TargetType="CollectionView">
                <Setter Property="BackgroundColor" Value="Transparent"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
