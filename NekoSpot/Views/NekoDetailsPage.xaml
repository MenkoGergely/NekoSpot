<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NekoSpot.NekoDetailsPage"
             xmlns:local="clr-namespace:NekoSpot"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             Title="Neko Details">


    

        <ScrollView>
            <VerticalStackLayout Spacing="16" MaximumWidthRequest="500">

                <Border HeightRequest="300" WidthRequest="300" StrokeShape="RoundRectangle 12" StrokeThickness="1" >
                <Grid>
                    <Label Text="🐱" FontSize="72" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Image Source="{Binding Cat.ImageURL}" Aspect="AspectFill"/>
                </Grid>
            </Border>

                <Border Padding="16" StrokeShape="RoundRectangle 12" StrokeThickness="1" >
                    <VerticalStackLayout Spacing="12">

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Name" FontSize="12" />
                            <Label Text="{Binding Cat.Name}" FontSize="14"   />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#EEEEEE"/>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Color" FontSize="12"/>
                            <Label  Text="{Binding Cat.Color}" FontSize="14"/>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#EEEEEE"/>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Seen Date" FontSize="12" />
                            <Label Text="{Binding Cat.SeenDate, StringFormat='{0:yyyy.MM.dd}'}" FontSize="14" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#EEEEEE"/>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Description" FontSize="12" />
                            <Label Text="{Binding Cat.Description}"  LineBreakMode="WordWrap" FontSize="14" />
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="#EEEEEE"/>

                    <maps:Map x:Name="catMap" HeightRequest="250" IsScrollEnabled="False" IsZoomEnabled="False"/>

                </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

       


</ContentPage>